{
  "name": "dsh-termfleet",
  "description": "团队驾驶舱：lead 与成员同装一个 dsh 插件，获得跨成员远程桌面围观、终端/DSH 会话接管、IM 审批、任务面板与团队记忆，全部动作过统一同意/审计总线",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "doc:init": "node scripts/doclib.mjs init",
    "doc:status": "node scripts/doclib.mjs status",
    "doc:health": "node scripts/doclib.mjs health",
    "doc:search": "node scripts/doclib.mjs search",
    "doc:plan": "node scripts/doclib.mjs new-plan",
    "doc:new-change": "node scripts/doclib.mjs new-change",
    "doc:update-change": "node scripts/doclib.mjs update-change",
    "doc:close-change": "node scripts/doclib.mjs close-change",
    "doc:promote-plan": "node scripts/doclib.mjs promote-plan",
    "doc:record-bug": "node scripts/doclib.mjs record-bug",
    "doc:sync-module": "node scripts/doclib.mjs sync-module"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  }
}
