{
  "name": "dsh-termfleet",
  "description": "TermFleet —— dsh 团队驾驶舱插件：会话级远程协作（成员 dsh 会话实时镜像+插话，同意握手/限时/全程审计）、pwsh 探针终端、TF-JOIN 一句话入队、共享任务板、IM 审批卡、避坑库",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IKEASven69/dsh-termfleet.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "team",
    "session",
    "remote",
    "cockpit"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "doc:init": "node scripts/doclib.mjs init",
    "doc:status": "node scripts/doclib.mjs status",
    "doc:health": "node scripts/doclib.mjs health",
    "doc:search": "node scripts/doclib.mjs search",
    "doc:plan": "node scripts/doclib.mjs new-plan",
    "doc:new-change": "node scripts/doclib.mjs new-change",
    "doc:update-change": "node scripts/doclib.mjs update-change",
    "doc:close-change": "node scripts/doclib.mjs close-change",
    "doc:promote-plan": "node scripts/doclib.mjs promote-plan",
    "doc:record-bug": "node scripts/doclib.mjs record-bug",
    "doc:sync-module": "node scripts/doclib.mjs sync-module",
    "doc:seal": "node scripts/doclib.mjs seal",
    "doc:linkcheck": "node scripts/doclib.mjs linkcheck"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "ws": "^8.21.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
